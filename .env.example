# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#     cp .env.example .env
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Yahoo Fantasy Sports API -------------------------------------------------
# Create an app at https://developer.yahoo.com/apps/create/
# Required permission: "Fantasy Sports" -> Read (or Read/Write for automation)
YAHOO_CONSUMER_KEY=your_yahoo_consumer_key_here
YAHOO_CONSUMER_SECRET=your_yahoo_consumer_secret_here

# --- League / team selection --------------------------------------------------
# league_id is the numeric id in your Yahoo league URL:
#   https://basketball.fantasysports.yahoo.com/nba/123456   -> 123456
YAHOO_LEAGUE_ID=000000
# team_id is the small number after `.t.` in the team URL, or the row of your
# team on the league standings page.
YAHOO_TEAM_ID=1
YAHOO_GAME_CODE=nba
# Optional: pin the season, e.g. 466 = 2025-26. Only needed if Yahoo cannot be
# reached to detect it automatically. Leave blank to auto-detect.
YAHOO_GAME_ID=
# Scoring format: "9cat" (head-to-head categories) or "points"
LEAGUE_TYPE=9cat

# --- LLM provider -------------------------------------------------------------
# The default provider is OpenRouter, which proxies Gemini and many other
# models behind an OpenAI-compatible API.
# Get a key at https://openrouter.ai/keys
LLM_API_KEY=sk-or-v1-your_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.0-flash-001
